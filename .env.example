# LaserClaw local environment template.
# Copy this file to .env for local development.
# Do not commit .env or real API keys.

# AI provider mode: mock, openai, or anthropic.
AI_PROVIDER=mock
STRICT_PROVIDER=false

# OpenAIProvider settings. Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# AnthropicProvider settings. Required only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TEMPERATURE=0.2

# Optional API-key auth. When REQUIRE_AUTH=true, clients must send X-LaserClaw-API-Key.
REQUIRE_AUTH=false
API_KEY=

# Backend settings.
# Docker Compose uses PostgreSQL; Launch-LaserClaw.bat overrides this to sqlite:///./laserclaw.db.
DATABASE_URL=postgresql://laserclaw:laserclaw123@db:5432/laserclaw
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800
AUTO_CREATE_TABLES=false

# RAG settings.
# EMBEDDING_PROVIDER=local is deterministic and offline.
# Use openai or sentence_transformers for dense embeddings.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_BACKEND=sql_json
VECTOR_STORE_DIR=/app/vector_store
RETRIEVAL_VECTOR_WEIGHT=0.72
RETRIEVAL_LEXICAL_WEIGHT=0.28
RETRIEVAL_MIN_SCORE=0.08
RETRIEVAL_LOW_CONFIDENCE_SCORE=0.14
RETRIEVAL_MIN_RESULTS=1

# Frontend API endpoint.
VITE_API_URL=http://127.0.0.1:8000

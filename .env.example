# LaserClaw 配置文件模板(首次运行 Launch-LaserClaw.bat 会自动把它复制为 .env)。
# 用记事本打开根目录的 .env 修改;不要提交 .env 或真实 API key 到 git。

# ============ 接入 AI 模型(最重要的一步) ============
# AI_PROVIDER 四选一填模型厂商,再把对应的 *_API_KEY 填上即可:
#   deepseek | qwen | zhipu | moonshot   (国内直接可用)
#   openai | anthropic                    (需海外账户)
#   mock                                  (演示模式:不联网,输出为固定模板)
AI_PROVIDER=mock
# 建议改成 true:key 配错时直接报错,而不是悄悄退回演示模式。
STRICT_PROVIDER=false

# --- 国内模型厂商(推荐):填对应 key,把上面 AI_PROVIDER 改成厂商名 ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-plus
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k

# --- OpenAI(AI_PROVIDER=openai 时填写) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic(AI_PROVIDER=anthropic 时填写) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TEMPERATURE=0.2

# ============ 以下为系统设置,一般不用改 ============

# 可选的 API-key 鉴权。REQUIRE_AUTH=true 时客户端必须携带 X-LaserClaw-API-Key。
REQUIRE_AUTH=false
API_KEY=

# 后端设置。docker-compose 会注入自己的 DATABASE_URL/UPLOAD_DIR,
# 环境变量的优先级永远高于本文件。
DATABASE_URL=sqlite:///./laserclaw.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
AUTO_CREATE_TABLES=false

# RAG 检索设置。EMBEDDING_PROVIDER=local 为确定性离线模式;
# 需要稠密向量检索时可改 sentence_transformers(较慢)或 openai。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_BACKEND=sql_json
VECTOR_STORE_DIR=./backend/vector_store
RETRIEVAL_VECTOR_WEIGHT=0.72
RETRIEVAL_LEXICAL_WEIGHT=0.28
RETRIEVAL_MIN_SCORE=0.08
RETRIEVAL_LOW_CONFIDENCE_SCORE=0.14
RETRIEVAL_MIN_RESULTS=1

# 前端访问的后端地址。
VITE_API_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql://laserclaw:laserclaw123@db:5432/laserclaw
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
AI_PROVIDER=mock
# Optional local subscription transport; CLI must run on this backend host.
CODEX_EXEC_MODEL=gpt-6.1-sol
CODEX_EXEC_PATH=
CODEX_EXEC_TIMEOUT_SECONDS=300
CODEX_EXEC_REASONING_EFFORT=medium

# RAG / embedding / retrieval
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_BACKEND=chroma
VECTOR_STORE_DIR=./backend/vector_store
RETRIEVAL_VECTOR_WEIGHT=0.75
RETRIEVAL_LEXICAL_WEIGHT=0.25
PGVECTOR_DIMENSION=384

# Reranker (set to sentence_transformers to enable cross-encoder reranking)
RERANKER_PROVIDER=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=20
RERANKER_WEIGHT=0.65
